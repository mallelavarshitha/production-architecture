# =========================================================================
# Project 75 — Production Architecture Environment Configuration Template
# Copy this file to .env before starting the containers:
#   cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
# Host Port Mapping
# NOTE: Project 20 occupies port 80 and 443. 
# Keep default 8081 or set another free port to avoid conflict.
# -------------------------------------------------------------------------
APP_PORT=8081

# -------------------------------------------------------------------------
# Node Environment Mode
# Set to 'production' on EC2 or 'development' during local debugging.
# -------------------------------------------------------------------------
NODE_ENV=production

# -------------------------------------------------------------------------
# MongoDB Credentials & Database Setup
# In production, replace these placeholders with strong random passwords!
# -------------------------------------------------------------------------
MONGO_DATABASE=taskdb
MONGO_USER=appuser
MONGO_PASSWORD=changeMeAppPass75_#Sec!
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeMeRootPass75_#Sec!

# -------------------------------------------------------------------------
# Backend MongoDB Connection URI (Optional Override)
# Leave commented out to auto-assemble using the variables above.
# -------------------------------------------------------------------------
# MONGO_URI=mongodb://appuser:changeMeAppPass75_#Sec!@mongodb:27017/taskdb?authSource=taskdb
